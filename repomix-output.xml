@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-slideDown {
  animation: slideDown 0.3s ease-out forwards;
}

/* ---- Compact hero for wide-but-short viewports (e.g. 14" 1080p laptops
   at 125% OS scaling, ~690px viewport height). Width guard keeps mobile
   untouched; taller desktops (>860px) keep the full-size layout. ---- */
@media (min-width: 1024px) and (max-height: 860px) {
  .hero-main {
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }
  .hero-badge {
    margin-bottom: 1.25rem;
  }
  .hero-headline {
    font-size: 3rem;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .hero-subhead {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .hero-ctas {
    margin-bottom: 1.5rem;
  }
  .hero-trust {
    margin-bottom: 1.5rem;
  }
  .hero-stat {
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
  }
  .hero-stat-value {
    font-size: 1.5rem;
  }
}

/* ---- Scroll-reveal (toggled via IntersectionObserver; transform/opacity only) ---- */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.reveal.reveal-visible {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ---- Timeline progress line: grows in once its .reveal parent is visible ---- */
.timeline-line {
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1) 0.35s;
}

.reveal-visible .timeline-line {
  transform: scaleX(1);
}

@media (prefers-reduced-motion: reduce) {
  .timeline-line {
    transform: none;
    transition: none;
  }
}

/* ---- Hero animations (transform/opacity only) ---- */
@keyframes hero-fade-up {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes hero-float {
  0%,
  100% {
    transform: translateY(-6px);
  }
  50% {
    transform: translateY(8px);
  }
}

.animate-hero-fade-up {
  animation: hero-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.animate-hero-float {
  animation: hero-float 7s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .animate-hero-fade-up,
  .animate-hero-float {
    animation: none;
    opacity: 1;
    transform: none;
  }
}

/* Hide scrollbar for Chrome, Safari and Opera */
.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

/* Hide scrollbar for IE, Edge and Firefox */
.scrollbar-hide {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}
</file>

