            <CalendarIcon className="mr-2 h-4 w-4 text-primary" />
            {value ? new Date(value).toLocaleDateString() : "Pick a date"}
          </Button>
        </PopoverTrigger>
        <PopoverContent className="w-auto p-0" align="start">
