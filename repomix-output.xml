export function CorporationFormationForm({ pricingData }) {
  const [loading, setLoading] = useState(false);
  const [formData, setFormData] = useState({
    desiredCompanyName: "",
    alternativeCompanyName: "",
    businessName: "",
    businessType: "",
    state: pricingData?.state || "",
    address: "",
    ownerInfo: "",
